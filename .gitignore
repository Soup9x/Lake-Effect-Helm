# dependencies
node_modules/
.pnp.*
.yarn/*

# next.js
/.next/
/out/
next-env.d.ts

# production
/build
/dist

# env / secrets — NEVER commit these
.env
.env.*
!.env.example
*.pem
*.key
helm-master-key*

# database
/db/migrations-generated/
*.dump

# typescript
*.tsbuildinfo

# misc
.DS_Store
*.log
# ANCHORED, and it has to be. `coverage/` matches a directory of that name at
# ANY depth, which silently swallowed src/lib/coverage and the /coverage route
# when group G added them — the files were on disk, the suite was green, and
# `git status` showed nothing. The pattern only ever meant the test-coverage
# report, which a runner writes to the repo root.
/coverage/
.vscode/
.idea/

# Deployment state generated by deploy/init-secrets.sh. The master key and every
# database password live here; committing either would be the single worst
# mistake available in this repository.
/deploy/secrets/
/deploy/tls/*
!/deploy/tls/.gitkeep
/deploy/data/

# Exported by deploy/setup.sh so it can be distributed to technicians. Not a
# secret — it is Caddy's public root certificate — but it is per-deployment
# output, and committing one deployment's CA into the repository is confusing
# at best.
/helm-root.crt
