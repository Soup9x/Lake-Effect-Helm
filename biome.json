{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/.next",
      "!**/dist",
      "!**/node_modules",
      "!next-env.d.ts",
      "!pnpm-lock.yaml",
      "!**/*.css"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "assist": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "useExhaustiveDependencies": "error",
        "useHookAtTopLevel": "error",
        "noUnusedVariables": "off",
        "noUnusedImports": "off"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": "off",
        "noEmptyBlockStatements": "off",
        "noImplicitAnyLet": "off",
        "noArrayIndexKey": "off"
      },
      "style": {
        "useImportType": "error",
        "useConst": "error",
        "noNonNullAssertion": "off",
        "useTemplate": "off"
      },
      "complexity": {
        "noForEach": "off",
        "useLiteralKeys": "off"
      },
      "performance": {
        "noImgElement": "off"
      },
      "a11y": {
        "preset": "recommended"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/lib/**", "src/workers/**", "scripts/**", "db/**", "tests/**"],
      "linter": {
        "rules": {
          "correctness": {
            "useHookAtTopLevel": "off"
          }
        }
      }
    },
    {
      "includes": ["tests/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off",
            "noExportsInTest": "off"
          }
        }
      }
    }
  ]
}
