# =============================================================================
# TLS in front of Helm.
#
# Required, not decorative. Helm sets `useSecureCookies` in production, so its
# session cookie carries the `__Secure-` prefix and browsers will not send it
# over plain http — without TLS, sign-in appears to succeed and every
# subsequent page reports you as signed out.
#
# HELM ANSWERS ON ANY ADDRESS THAT REACHES IT. The host's IP on the LAN, a
# hostname in internal DNS, the public name of a Cloudflare Tunnel or any
# other proxy: Caddy serves the application for all of them, and sign-in
# follows whichever address the browser used (AUTH_URL is deliberately left
# unset; see docker-compose.yml). Publishing Helm somewhere new needs nothing
# here — point the tunnel or proxy at this host's HTTPS port.
#
# Certificates come from HELM_TLS_DIRECTIVE, `tls internal` by default: Caddy
# mints them from its own CA, which needs no public DNS and no ACME. It issues
# one for every address in HELM_SITE_ADDRESSES (the LAN IP, plus a hostname if
# one was given), and hands the LAN IP's certificate to a browser that asks
# for any other name or for none. A tunnel or proxy terminates the browser's
# TLS itself, so the certificate it sees here only has to be accepted by the
# connector (No TLS Verify, or trust helm-root.crt).
#
# To use your own certificate instead, put the files in deploy/tls/ and set:
#   HELM_TLS_DIRECTIVE="tls /etc/helm/tls/helm.crt /etc/helm/tls/helm.key"
# For a publicly resolvable hostname with ACME, set it to the empty string and
# Caddy will obtain one from Let's Encrypt automatically.
# =============================================================================

{
	# Helm renders its own error pages; Caddy should not add another layer of
	# them, and its access log is the one place a request id can be correlated
	# with the application log.
	admin off

	# A browser that connects to an IP address sends no server name in the TLS
	# handshake (RFC 6066 forbids IP addresses there), and one arriving through
	# a name nobody listed sends a name Caddy has no certificate for. Without
	# these two lines Caddy has nothing to choose a certificate by and aborts
	# the handshake (ERR_SSL_PROTOCOL_ERROR). docker-compose.yml sets this to
	# HELM_LAN_ADDRESS, or to HELM_PUBLIC_HOST when there is none.
	default_sni {$HELM_DEFAULT_SNI}
	fallback_sni {$HELM_DEFAULT_SNI}

	# Keep X-Forwarded-For from a proxy on a private address — a Cloudflare
	# Tunnel connector, a load balancer on the LAN — instead of discarding it.
	# Caddy drops the incoming header from any source it does not trust, and
	# then every request Helm sees comes from the proxy's address: the per-IP
	# sign-in lockout counts everyone together and the audit log is blind.
	#
	# This does not change what Helm reads: Caddy still appends exactly one
	# entry of its own, and Helm counts HELM_TRUSTED_PROXY_HOPS entries from
	# the RIGHT. With nothing in front of Caddy the rightmost entry is the
	# client, hops stays 1, and a client on the LAN who sends a forged header
	# gains nothing. With a trusted proxy in front, set hops to 2.
	servers {
		trusted_proxies static private_ranges
	}

	log {
		format json
	}
}

# The listed addresses get certificates; the bare `https://` makes the site
# answer every other Host as well, which is what lets a tunnel or proxy
# publish Helm under a name this file has never heard of.
{$HELM_SITE_ADDRESSES}, https:// {
	{$HELM_TLS_DIRECTIVE}

	encode gzip

	reverse_proxy web:3000 {
		# Exactly one X-Forwarded-For entry is appended here, which is why the
		# application runs with HELM_TRUSTED_PROXY_HOPS=1 when Caddy is the only
		# proxy. Change one and you must change the other: Helm reads the client
		# address that many places from the right, because the leftmost entry
		# is client-controlled and trusting it would defeat API token IP
		# allowlisting.
		header_up X-Real-IP {remote_host}
	}

	# No response timeout is configured, and that is deliberate: an export
	# bundle for a large client takes a while to render and a while to stream.
	# Caddy's default is no timeout — do not "tidy that up" to 30s, or handovers
	# for the biggest clients will be the ones that fail.

	# Helm already sets HSTS, X-Frame-Options, Referrer-Policy and a no-store
	# Cache-Control on every response (next.config.ts). Caddy must not strip or
	# duplicate them, so nothing is added here.

	log {
		format json
	}
}

# Plain http exists only to redirect, for every address, to the same address
# over https. The port is added only when HTTPS is not on 443, because the
# host's published port is not one Caddy can see from inside its container.
http:// {
	map {$HELM_HTTPS_PORT} {https_suffix} {
		443 ""
		default ":{$HELM_HTTPS_PORT}"
	}
	redir https://{host}{https_suffix}{uri} 308
}
