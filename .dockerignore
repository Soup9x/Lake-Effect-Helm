# Everything the build does not need. Without this, `COPY . .` drags the local
# node_modules, a stale .next, and the entire git history into the build
# context — which is slow, and which is how a .env.local that was never meant
# to leave a laptop ends up in an image layer.

.git
.gitignore
node_modules
.next
dist
coverage
*.log

# Never. These are the files an operator fills in with real credentials.
.env
.env.*
!.env.example

# Deployment state: generated keys, TLS material, database volumes.
deploy/secrets
deploy/data
# An operator's own certificate and key go in deploy/tls (see the Caddyfile).
# `COPY . .` in the builder stage would otherwise carry the private key into
# the build context and the layer cache. The same for key material anywhere.
deploy/tls
*.pem
*.key
*.crt
helm-master-key*
helm-root.crt

# Test and tooling surface the image has no use for.
tests
db/tests
docs
.github
.githooks
.vscode
.idea
*.tsbuildinfo
AGENTS.md
CLAUDE.md
extension
