{
  "name": "lake-effect-helm",
  "version": "0.1.0",
  "private": true,
  "description": "Lake Effect Helm \u2014 multi-tenant MSP documentation and credential platform.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:migrate": "tsx db/migrate.ts",
    "db:migrate:status": "tsx db/migrate.ts --status",
    "db:drift": "tsx scripts/check-drift.ts",
    "db:generate": "drizzle-kit generate --name manual",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:sql": "./scripts/run-tests.sh",
    "verify": "pnpm typecheck && pnpm test && pnpm db:drift"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "drizzle-orm": "^0.44.6",
    "next": "^16.3.5",
    "next-auth": "5.0.0-beta.32",
    "postgres": "^3.4.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
