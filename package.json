{
  "name": "lake-effect-helm",
  "version": "0.1.0",
  "private": true,
  "description": "Lake Effect Helm — multi-tenant MSP documentation and credential platform.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:worker": "node scripts/build-worker.mjs",
    "start": "next start",
    "db:migrate": "tsx db/migrate.ts",
    "db:migrate:status": "tsx db/migrate.ts --status",
    "db:drift": "tsx scripts/check-drift.ts",
    "helm:bootstrap": "tsx scripts/bootstrap.ts",
    "helm:rotate-kek": "tsx scripts/rotate-kek.ts",
    "helm:worker": "tsx src/workers/main.ts",
    "helm:worker:once": "tsx src/workers/main.ts --once",
    "db:generate": "drizzle-kit generate --name manual",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:sql": "./scripts/run-tests.sh",
    "verify": "pnpm typecheck && pnpm test && pnpm db:drift"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@node-rs/argon2": "^2.2.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "bullmq": "^6.3.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.46.0",
    "next": "^16.3.5",
    "next-auth": "5.0.0-beta.32",
    "postgres": "^3.4.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.20.6",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.18.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
